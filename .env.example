# ── 필수 ────────────────────────────────────────────────
# 네이버 쇼핑 검색 API (https://developers.naver.com/)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Anthropic Console API 키 (https://console.anthropic.com/ 에서 1회 발급)
# Agent SDK 웹리서치(비교가/리뷰) + 팝업/전시 큐레이션에 사용. 미설정 시 Claude Code 로그인 자격증명으로 동작.
ANTHROPIC_API_KEY=

# ── 팝업/전시 날짜 검증 (insane-engine, 선택) ─────────────
# 차단된 실제 행사 페이지를 우회 fetch 해 시작/종료일을 검증하고 종료된 행사를 제외한다.
# 최초 1회: bash tools/insane-engine/setup.sh  (python venv + curl_cffi/bs4 설치)
# EVENTS_VERIFY_DATES=true       # false 로 끄면 엔진 없이 큐레이션만
# INSANE_PYTHON=                 # 기본: tools/insane-engine/.venv/bin/python3
# INSANE_ENGINE_DIR=            # 기본: tools/insane-engine
# INSANE_MAX_ATTEMPTS=18        # fetch 격자 시도 상한

# ── 서버/스케줄 (선택, 아래는 기본값) ─────────────────────
PORT=7777
# 매일 가격 수집 시각 (HH:mm, 24h)
COLLECT_TIME=09:00
# 매일 팝업/전시 갱신 시각 (HH:mm, 24h)
EVENTS_COLLECT_TIME=10:00
# 팝업/전시 '신규' 배지: 이만큼(일) 이상 목록에 없다가 다시 나오면 신규 판정
# EVENTS_NEW_GAP_DAYS=7
# '신규' 배지 유지 일수(재등장일로부터)
# EVENTS_NEW_SHOW_DAYS=3
# 매일 뉴스 다이제스트 수집 시각(들) (쉼표 구분, HH:mm)
NEWS_COLLECT_TIMES=08:00,17:00
# 매일 유튜브 소식 수집 시각(들) (쉼표 구분, HH:mm)
YOUTUBE_COLLECT_TIMES=08:30
# '본영상'으로 체크한 영상을 이만큼(일) 동안 수집(검색)에서 제외
# YOUTUBE_WATCHED_EXCLUDE_DAYS=7
# 유튜브 소식 신선도: 최근 N일 이내 업로드 영상만 채택
YOUTUBE_FRESH_DAYS=7
# 한국장 브리핑 시각. 09:00 개장 전 프리뷰라 08:00.
STOCK_KR_COLLECT_TIMES=08:00
# 미국장 브리핑 시각(전일 뉴욕 종가 결산 + 당일 밤 개장 프리뷰).
# 17:00 은 뉴욕 종가(당일 06시 확정)와 야간 개장(22:30) 사이 死구간이라 새 재료가 없다.
# 18:00 은 뉴욕 프리마켓 개장(04~05시 ET)과 겹쳐 선물·프리마켓 재료가 실제로 존재한다.
STOCK_US_COLLECT_TIMES=18:00
# 종목 시세 조회 간 간격(ms). 네이버에 대한 매너 — 연타 금지.
# STOCK_FETCH_DELAY_MS=300
#
# 증시 휴장일은 API 키 없이 달력 규칙으로 계산한다(양력 공휴일 + 음력 설·추석·부처님오신날
# + 대체공휴일 + 근로자의날·연말 폐장일). 음력은 Node 내장 ICU 의 dangi 달력을 쓴다.
# 계산이 원리적으로 불가능한 임시공휴일(정부 수시 지정)만 data/stock-holidays.json 원장에
# 수동으로 넣으면 계산 결과 위에 덮어써진다.
# Agent SDK 큐레이션(뉴스/유튜브/팝업전시) 1회 최대 대기(ms). 초과 시 중단(hang 방지). 기본 30분
AGENT_QUERY_TIMEOUT_MS=1800000
# DB 파일 경로 (기본: <repo>/data/price.db)
# DB_PATH=/Users/daegun/Workspace/price/data/price.db
# 임포트할 기존 이력 JSON 경로
LEGACY_HISTORY_JSON=/Users/daegun/Documents/Claude/Projects/자동화/daily-price-tracker/price_history.json
# 가격 이력 보존 일수
HISTORY_RETENTION_DAYS=90

# ── 알림 (선택) ──────────────────────────────────────────
# 이메일 알림 on/off
NOTIFY_EMAIL=true
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# iMessage 알림(macOS 전용, 본인에게 1:1). 이메일과 함께 보냄.
# 최초 1회 'Messages 제어' 자동화 권한 승인 필요(POST /api/notify/imessage/test 로 검증).
NOTIFY_IMESSAGE=false
# 수신자: 본인 전화번호 E.164(예: +821012345678) 또는 iMessage용 Apple ID 이메일
IMESSAGE_TO=
